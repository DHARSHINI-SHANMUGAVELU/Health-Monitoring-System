#define BLYNK_TEMPLATE_ID   "TMPL3GZBU3srA"
#define BLYNK_TEMPLATE_NAME "HEALTH MONITORING SYSTEM"
#define BLYNK_AUTH_TOKEN    "PBx4luj7d1ZPYVrGR1ISkXv8z2jjJxuN"
#include <Wire.h>
#include <WiFi.h>
#include <BlynkSimpleEsp32.h>
#include <Adafruit_MPU6050.h>
#include <Adafruit_Sensor.h>
#include <OneWire.h>
#include <DallasTemperature.h>
char ssid[] = "SARASAROSHAN";
char pass[] = "6d24135ead9d";
#define ONE_WIRE_BUS 4 // GPIO4 for DS18B20
OneWire oneWire(ONE_WIRE_BUS);
DallasTemperature sensors(&oneWire);
Adafruit_MPU6050 mpu;
int stepCount = 0;
float threshold = 1.2;     
bool stepDetected = false;
unsigned long lastStepTime = 0;
unsigned long stepInterval = 300; // Minimum time between steps (ms)
BlynkTimer timer;
void sendTemperature() {
  sensors.requestTemperatures();
  float tempC = sensors.getTempCByIndex(0);
  Serial.print("Temperature: ");
  Serial.print(tempC);
  Serial.println(" °C");

  Blynk.virtualWrite(V0, tempC); // Send temperature to Blynk V0
}
void readSteps() {
  sensors_event_t a, g, temp;
  mpu.getEvent(&a, &g, &temp);


  float totalAcceleration = sqrt(
    a.acceleration.x * a.acceleration.x +
    a.acceleration.y * a.acceleration.y +
    a.acceleration.z * a.acceleration.z
  );

  float accWithoutGravity = abs(totalAcceleration - 9.8);

  unsigned long currentTime = millis();
  if (accWithoutGravity > threshold && !stepDetected) {
    if (currentTime - lastStepTime > stepInterval) {
      stepCount++;
      lastStepTime = currentTime;
      Serial.print("Step Count: ");
      Serial.println(stepCount);

      Blynk.virtualWrite(V1, stepCount);
    }
    stepDetected = true;
  } else if (accWithoutGravity < 0.8) {
    stepDetected = false;
  }
}
void setup() {
  Serial.begin(115200);

  sensors.begin();
  Wire.begin(21, 22);  // SDA = GPIO21, SCL = GPIO22

  if (!mpu.begin()) {
    Serial.println("Failed to find MPU6050 chip");
    while (1) delay(10);
  }
  Serial.println("MPU6050 connected successfully!");
  
  mpu.setAccelerometerRange(MPU6050_RANGE_4_G);
  mpu.setGyroRange(MPU6050_RANGE_500_DEG);
  mpu.setFilterBandwidth(MPU6050_BAND_21_HZ);
  delay(100);

  Blynk.begin(BLYNK_AUTH_TOKEN, ssid, pass);
  
  timer.setInterval(2000L, sendTemperature);  // Send temp every 2s
  timer.setInterval(500L, readSteps);         // Read steps every 0.5s
}

void loop() {
  Blynk.run();
  timer.run();
}
